# Copy to .env (git-ignored) for local runs. Real values live ONLY in CI / hosting secrets.
DATABASE_URL=postgresql+psycopg://app:CHANGE_ME@localhost:5432/invoice_agent
OWNER_DATABASE_URL=postgresql+psycopg://owner:owner@localhost:5432/invoice_agent
CORS_ORIGINS=http://localhost:5173
GEMINI_API_KEY=
GROQ_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
ANTHROPIC_API_KEY=
# LLM gateway (app/llm). Uncomment to override a default; see app/config.py for the defaults.
# LLM_PROVIDER=
# LLM_FALLBACK_PROVIDER=
# LLM_MODEL_EXTRACT=
# LLM_MODEL_AGENT=
# LLM_MODEL_EXTRACT_GEMINI=
# LLM_MODEL_AGENT_GEMINI=
# LLM_MODEL_EXTRACT_GROQ=
# LLM_MODEL_AGENT_GROQ=
# LLM_MODEL_EXTRACT_ANTHROPIC=
# LLM_MODEL_AGENT_ANTHROPIC=
# LLM_DAILY_SOFT_CAP_GEMINI=
# LLM_DAILY_SOFT_CAP_GROQ=
# LLM_DAILY_SOFT_CAP_ANTHROPIC=
# LLM_DAILY_CAP_PER_DEMO_TOKEN=
# Set to true once on the deployed service to send one traced Gemini call to Langfuse, then unset.
LLM_PING_ON_STARTUP=false
